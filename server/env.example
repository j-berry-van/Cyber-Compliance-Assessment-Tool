# Multi-user mode (accounts + shared database). Without this the server is only the AI proxy.
MULTIUSER=true
PORT=4000
DATA_DIR=./data
# Serve the built React app from the same port (build with REACT_APP_SERVER_MODE=true INLINE_RUNTIME_CHUNK=false).
STATIC_DIR=../build
# Set to true when served over HTTPS. Not set automatically: behind an HTTPS proxy use COOKIE_SECURE=true or TRUST_PROXY=true.
# Over plain http:// (other than localhost) a Secure cookie is dropped and sign-in fails.
COOKIE_SECURE=false
# Set true behind a reverse proxy that sets X-Forwarded-Proto so the session cookie gets Secure and rate limiting sees the client IP.
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000
